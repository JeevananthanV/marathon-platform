# ==============================================================================
# MARATHON REGISTRATION & MARKETING AUTOMATION PLATFORM - ENVIRONMENT CONFIG
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=production
DEBUG=false
PROJECT_NAME="Marathon Registration & Marketing Automation Platform"
VERSION=1.0.0
API_V1_STR=/api/v1

# Security & Secrets
SECRET_KEY=generate_a_random_64_character_hex_string_for_production
ADMIN_API_KEY=marathon_admin_secret_2026

# Database Configuration (PostgreSQL in production, SQLite async in development)
# Production: postgresql+asyncpg://marathon_admin:secure_password@db:5432/marathon_db
DATABASE_URL=sqlite+aiosqlite:///./marathon.db
POSTGRES_USER=marathon_admin
POSTGRES_PASSWORD=marathon_secure_password_123
POSTGRES_DB=marathon_db

# CORS Configuration (Comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:80","https://marathon.yourdomain.com"]

# Integration Mode Flags (true = Deterministic MOCK mode for local demo/tests, false = Live API)
INTEGRATIONS_MOCK_MODE=true

# 1. Razorpay Payment Gateway (Test or Live Credentials)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_123

# 2. Zoho CRM API v2/v6
ZOHO_CLIENT_ID=mock_zoho_client_id
ZOHO_CLIENT_SECRET=mock_zoho_client_secret
ZOHO_REFRESH_TOKEN=mock_zoho_refresh_token
ZOHO_API_DOMAIN=https://www.zohoapis.com

# 3. WhatsApp Business Cloud API (Meta Graph API v20.0)
WHATSAPP_ACCESS_TOKEN=mock_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=100000000000001
WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000001
WHATSAPP_WEBHOOK_VERIFY_TOKEN=mock_verify_token_marathon_2026

# 4. n8n Automation Engine
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_SECRET=n8n_secure_webhook_secret_2026

# 5. Meta Conversions API (CAPI) & Pixel
META_PIXEL_ID=mock_pixel_1234567890
META_ACCESS_TOKEN=mock_meta_access_token
META_API_VERSION=v20.0
META_TEST_EVENT_CODE=TEST12345

# Event Meta Information
EVENT_NAME="Bengaluru Midnight Marathon 2026"
EVENT_DATE="2026-12-12"
EVENT_LOCATION="Bengaluru, Karnataka, India"
