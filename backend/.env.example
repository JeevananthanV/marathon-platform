# =================================================================
# Marathon Registration & Marketing Automation Platform
# Backend Environment Configuration Template
# =================================================================

# Server & App Settings
PROJECT_NAME="Marathon Registration & Marketing Automation Platform"
VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Event Constants
EVENT_NAME="City Marathon 2026"
EVENT_DATE="Sunday, October 18, 2026"
EVENT_VENUE="Kanteerava Stadium, Bengaluru"
EVENT_REPORTING_TIME="05:00 AM"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+asyncpg://marathon_user:marathon_pass@localhost:5432/marathon_db

# Razorpay Payment Gateway (TEST MODE)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Global Mock Mode (Set to true in development/testing, false in production)
INTEGRATIONS_MOCK_MODE=true

# 1. Zoho CRM Integration (Phase 4B)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://www.zohoapis.com

# 2. WhatsApp Business Cloud API (Phase 4C)
WHATSAPP_ENABLED=true
WHATSAPP_MOCK_MODE=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=marathon_wa_verify_token_2026

# 3. n8n Automation Engine (Phase 4D)
N8N_ENABLED=true
N8N_MOCK_MODE=true
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=marathon_n8n_secret_2026

# 4. Meta Conversions API (CAPI) (Phase 4E)
META_CAPI_ENABLED=true
META_CAPI_MOCK_MODE=true
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v20.0
META_TEST_EVENT_CODE=
