# ==============================================================================
# MARATHON BACKEND PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ==============================================================================

APP_NAME="Marathon 2026 Registration"
APP_ENV=production
DEBUG=false
WEB_CONCURRENCY=4
PORT=8000
HOST=0.0.0.0

EVENT_NAME="Bengaluru Midnight Marathon 2026"
EVENT_DATE="2026-11-22"
EVENT_VENUE="Kanteerava Stadium, Bengaluru, Karnataka"

# Production Managed PostgreSQL Connection String
DATABASE_URL=postgresql+asyncpg://marathon_prod_user:CHANGE_ME_STRONG_PASSWORD@db_host:5432/marathon_prod_db

# Production Domain CORS Origins (Strictly restricted)
CORS_ORIGINS=https://marathon.yourdomain.com,https://www.marathon.yourdomain.com

# Master Mock Mode Flag (Set to 'false' only after full demo approval and credential verification)
INTEGRATIONS_MOCK_MODE=true

# ------------------------------------------------------------------------------
# 1. Razorpay Payment Gateway (Live Keys)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME_LIVE_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# 2. Zoho CRM (Phase 4B Live Credentials)
# ------------------------------------------------------------------------------
ZOHO_MOCK_MODE=true
ZOHO_CLIENT_ID=1000.CHANGE_ME_ZOHO_CLIENT_ID
ZOHO_CLIENT_SECRET=CHANGE_ME_ZOHO_SECRET
ZOHO_REFRESH_TOKEN=1000.CHANGE_ME_REFRESH_TOKEN
ZOHO_API_DOMAIN=https://www.zohoapis.com

# ------------------------------------------------------------------------------
# 3. WhatsApp Business Cloud API (Phase 4C Live Credentials)
# ------------------------------------------------------------------------------
WHATSAPP_MOCK_MODE=true
WHATSAPP_ACCESS_TOKEN=EAAG...CHANGE_ME_PERMANENT_SYSTEM_USER_TOKEN
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME_WABA_ID
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_CUSTOM_SECRET_VERIFY_TOKEN

# ------------------------------------------------------------------------------
# 4. n8n Automation Engine (Phase 4D Production Credentials)
# ------------------------------------------------------------------------------
N8N_MOCK_MODE=true
N8N_BASE_URL=https://n8n.yourdomain.com
N8N_WEBHOOK_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET

# ------------------------------------------------------------------------------
# 5. Meta Conversions API (CAPI) (Phase 4E Live Credentials)
# ------------------------------------------------------------------------------
META_CAPI_ENABLED=true
META_CAPI_MOCK_MODE=true
META_PIXEL_ID=CHANGE_ME_LIVE_PIXEL_ID
META_ACCESS_TOKEN=EAAG...CHANGE_ME_META_SYSTEM_USER_TOKEN
META_API_VERSION=v20.0
META_TEST_EVENT_CODE=
