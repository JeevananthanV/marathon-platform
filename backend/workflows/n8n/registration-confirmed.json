{
  "name": "Marathon - 01. Registration Confirmed Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "registration-confirmed",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $headers['x-n8n-webhook-secret'] }}",
              "value2": "={{ $env.N8N_WEBHOOK_SECRET }}"
            }
          ]
        }
      },
      "name": "Validate Auth Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_API_URL || 'http://localhost:8000' }}/api/v1/automation/trigger-action",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"action\": \"whatsapp_confirmation\",\n  \"registration_id\": \"{{ $json.data.registration_id }}\"\n}"
      },
      "name": "Trigger WhatsApp Confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [700, 200]
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_API_URL || 'http://localhost:8000' }}/api/v1/automation/trigger-action",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"action\": \"zoho_sync\",\n  \"registration_id\": \"{{ $json.data.registration_id }}\"\n}"
      },
      "name": "Trigger Zoho CRM Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [950, 200]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Validate Auth Secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Auth Secret": {
      "main": [
        [
          {
            "node": "Trigger WhatsApp Confirmation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger WhatsApp Confirmation": {
      "main": [
        [
          {
            "node": "Trigger Zoho CRM Sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
